# ---- sloped 组件库 .gitignore ----
# 备份基线（历次升级双件，体积大且为内部快照，不入仓库）
.backup/

# 临时产物（中间脚本、日志、后台注册表）
.temp/

# 线上截图原料区（含未发布素材与描述文档，体积大，按需单独管理）
references/

# AI 生成业务页面归档（含实际业务数据，按需单独管理）
pages/

# macOS 系统文件
.DS_Store
._*

# Python 缓存（如本地起过静态服务）
__pycache__/
*.pyc

# 日志
*.log
# WorkBuddy 本地工作记录（AI 会话日志，不入公开仓库）
.workbuddy/
